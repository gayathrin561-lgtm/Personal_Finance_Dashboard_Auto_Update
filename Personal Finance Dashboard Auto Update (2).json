    {
      "parameters": {
        "jsCode": "const rows = $input.all();\n\nlet income = 0;\nlet expenses = 0;\n\nfor (const item of rows) {\n  const type = String(item.json.Type || \"\")\n    .trim()\n    .toLowerCase();\n\n  const amount = Number(\n    String(item.json.Amount || 0).replace(/[,₹]/g, \"\")\n  );\n\n  if (!Number.isFinite(amount)) {\n    continue;\n  }\n\n  if (type === \"income\") {\n    income += amount;\n  } else if (type === \"expense\") {\n    expenses += amount;\n  }\n}\n\nconst savings = income - expenses;\n\nreturn [\n  {\n    json: {\n      Total_Income: income,\n      Total_Expenses: expenses,\n      Total_Savings: savings,\n      Last_Updated: new Date().toISOString()\n    }\n  }\n];"
      },
